# Server
PORT=8081
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,https://case-documentation-kb.web.app,https://case-documentation-kb.firebaseapp.com

# Firebase Admin (server-only — NEVER put these in the frontend)
FIREBASE_PROJECT_ID=case-documentation-kb
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@case-documentation-kb.iam.gserviceaccount.com
# Paste a NEWLY generated key here locally only (keep \n escapes). Never commit it.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=case-documentation-kb.firebasestorage.app

# Uploads
MAX_FILE_SIZE_MB=10
MAX_DOCUMENTS=4

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
