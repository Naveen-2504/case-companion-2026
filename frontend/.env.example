# REST API base. Locally Vite proxies /api to the backend; on Firebase Hosting
# the /api/** rewrite forwards to the Cloud Function, so "/api" works everywhere.
VITE_API_URL=/api
VITE_MAX_FILE_SIZE_MB=10

# Firebase web config (public identifiers, safe for the browser — NOT secrets).
VITE_FIREBASE_API_KEY=REPLACE_WITH_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=case-documentation-kb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=case-documentation-kb
VITE_FIREBASE_STORAGE_BUCKET=case-documentation-kb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1057280235214
VITE_FIREBASE_APP_ID=1:1057280235214:web:ba3a4ca2e5ead795fe229f
VITE_FIREBASE_MEASUREMENT_ID=G-VM9SC1LGC5
